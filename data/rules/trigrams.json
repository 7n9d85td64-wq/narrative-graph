{
  "node_id": "trigrams",
  "type": "rule",
  "name": "八卦向量组（标准坐标系）",
  "version": "3.1.0",
  "description": "八卦是8维超立方体的8个顶点。阳爻=该维度高值，阴爻=低值。既是精确度量坐标，也是不可完全形式化的能量模式。",
  "properties": {
    "standard_vectors": {
      "乾": {"F":0.95,"D":0.05,"A":0.10,"P":0.80,"Dir":0.85,"Pen":0.90,"B":0.98,"T":0.70,"yin_yang":"阳"},
      "坤": {"F":0.05,"D":0.98,"A":0.00,"P":0.90,"Dir":-0.90,"Pen":0.95,"B":0.02,"T":0.05,"yin_yang":"阴"},
      "震": {"F":0.80,"D":0.20,"A":0.90,"P":0.60,"Dir":0.70,"Pen":0.75,"B":0.30,"T":0.50,"yin_yang":"阳"},
      "坎": {"F":0.20,"D":0.75,"A":0.30,"P":0.40,"Dir":-0.60,"Pen":0.70,"B":0.10,"T":0.10,"yin_yang":"阴"},
      "离": {"F":0.85,"D":0.15,"A":0.60,"P":0.50,"Dir":0.80,"Pen":0.80,"B":0.70,"T":0.85,"yin_yang":"阳"},
      "艮": {"F":0.60,"D":0.50,"A":0.10,"P":0.95,"Dir":0.00,"Pen":0.40,"B":0.65,"T":0.20,"yin_yang":"阴"},
      "兑": {"F":0.30,"D":0.10,"A":0.20,"P":0.10,"Dir":0.30,"Pen":0.20,"B":0.20,"T":0.15,"yin_yang":"阳"},
      "巽": {"F":0.40,"D":0.40,"A":0.15,"P":0.70,"Dir":0.20,"Pen":0.85,"B":0.60,"T":0.55,"yin_yang":"阴"}
    },
    "opposite_pairs": [
      ["乾","坤"], ["震","巽"], ["坎","离"], ["艮","兑"]
    ],
    "judgment_rules": {
      "distance_formula": "√[Σ(V_actual_i - V_standard_i)² / 8]",
      "thresholds": {
        "dist_lt_0.3": "唯一卦象判定",
        "dist_0.3_to_0.6": "多卦象混合，取距离最小的两个",
        "dist_gte_0.6": "无主导卦象，过渡态"
      }
    },
    "opposite_collision_rule": {
      "trigger": "对宫卦在80字内同时出现",
      "effect": "EXP权重从0.4临时提升至0.6",
      "requirement": "开局序列中至少包含一次对宫碰撞"
    }
  },
  "edges": [
    {"relation": "coordinates", "target": "space_8d"},
    {"relation": "basis_for", "target": "wuxing_flow"},
    {"relation": "basis_for", "target": "desire_matrix"}
  ]
}
